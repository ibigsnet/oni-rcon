FROM python:3.13-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
COPY requirements.lock /build/requirements.lock
RUN pip install --no-cache-dir --require-hashes --no-deps -r /build/requirements.lock
COPY src/oni_rcon /app/oni_rcon
COPY LICENSE NOTICE /app/
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ONI_RCON_NO_UPDATE=1
USER 65534:65534
ENTRYPOINT ["python", "-m", "oni_rcon.fleet"]
